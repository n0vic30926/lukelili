{
  "portfolio_path": "data/private/portfolio.local.json",
  "example_portfolio_path": "data/examples/portfolio.example.json",
  "report_output_dir": "reports",
  "daily_report_dir": "reports/daily",
  "weekly_report_dir": "reports/weekly",
  "cache_dir": "cache",
  "log_dir": "logs",
  "use_cache": true,
  "cache_ttl_hours": 6,
  "freshness_max_age_hours": 24,
  "freshness_thresholds": {
    "official": 168,
    "market_data": 24,
    "vendor": 24,
    "media": 12,
    "social": 6,
    "unknown": 24
  },
  "etf_analysis": {
    "premium_discount_warn_pct": 0.5,
    "premium_discount_high_pct": 1.0,
    "tracking_error_warn": 0.005,
    "tracking_error_high": 0.01
  },
  "macro_indicators": [
    {
      "id": "china_cpi",
      "label": "中国CPI",
      "candidate_functions": ["macro_china_cpi_monthly", "macro_china_cpi_yearly"],
      "date_columns": ["月份", "日期", "时间"],
      "value_columns": ["今值", "最新值", "CPI", "居民消费价格指数", "value"],
      "unit": "%",
      "cadence": "monthly",
      "max_age_days": 75,
      "release_calendar": {
        "source": "NBS official release calendar",
        "source_tier": "official",
        "next_release_date": "",
        "note": "Fill in the next official release date in settings.local.json."
      },
      "risk_note": "通胀影响利率预期和权益估值。",
      "interpretation": {
        "trend_up": "通胀上行，利率和估值压力需要观察。",
        "trend_down": "通胀回落，估值压力可能边际缓和。",
        "flat": "通胀持平，继续观察下一期数据。"
      }
    },
    {
      "id": "china_ppi",
      "label": "中国PPI",
      "candidate_functions": ["macro_china_ppi_monthly", "macro_china_ppi_yearly"],
      "date_columns": ["月份", "日期", "时间"],
      "value_columns": ["今值", "最新值", "PPI", "工业品出厂价格指数", "value"],
      "unit": "%",
      "cadence": "monthly",
      "max_age_days": 75,
      "release_calendar": {
        "source": "NBS official release calendar",
        "source_tier": "official",
        "next_release_date": "",
        "note": "Fill in the next official release date in settings.local.json."
      },
      "risk_note": "PPI反映上游价格压力和工业周期。",
      "interpretation": {
        "trend_up": "工业品价格压力上行，观察利润率和补库存周期。",
        "trend_down": "工业品价格压力回落，观察需求是否同步走弱。",
        "flat": "PPI变化不大，继续观察趋势。"
      }
    },
    {
      "id": "china_pmi",
      "label": "中国PMI",
      "candidate_functions": ["macro_china_pmi_yearly", "macro_china_pmi"],
      "date_columns": ["月份", "日期", "时间"],
      "value_columns": ["今值", "最新值", "制造业PMI", "PMI", "value"],
      "unit": "",
      "cadence": "monthly",
      "max_age_days": 45,
      "release_calendar": {
        "source": "NBS official release calendar",
        "source_tier": "official",
        "next_release_date": "",
        "note": "Fill in the next official release date in settings.local.json."
      },
      "risk_note": "PMI高于50通常表示扩张，低于50通常表示收缩。",
      "interpretation": {
        "threshold": 50,
        "above": "制造业处于扩张区间。",
        "below": "制造业处于收缩区间。"
      }
    },
    {
      "id": "china_money_supply",
      "label": "中国M2",
      "candidate_functions": ["macro_china_money_supply"],
      "date_columns": ["月份", "日期", "时间"],
      "value_columns": ["M2-同比增长", "M2同比", "货币和准货币(M2)同比增长", "今值", "value"],
      "unit": "%",
      "cadence": "monthly",
      "max_age_days": 75,
      "release_calendar": {
        "source": "PBOC official release calendar",
        "source_tier": "official",
        "next_release_date": "",
        "note": "Fill in the next official release date in settings.local.json."
      },
      "risk_note": "M2反映流动性环境。",
      "interpretation": {
        "trend_up": "流动性同比增速上行，风险资产流动性环境可能改善。",
        "trend_down": "流动性同比增速回落，观察信用和估值压力。",
        "flat": "M2同比变化不大，继续观察社融配合。"
      }
    },
    {
      "id": "china_gdp",
      "label": "中国GDP",
      "candidate_functions": ["macro_china_gdp_yearly"],
      "date_columns": ["季度", "日期", "时间", "年份"],
      "value_columns": ["今值", "GDP同比", "国内生产总值同比增长", "value"],
      "unit": "%",
      "cadence": "quarterly",
      "max_age_days": 140,
      "release_calendar": {
        "source": "NBS official release calendar",
        "source_tier": "official",
        "next_release_date": "",
        "note": "Fill in the next official release date in settings.local.json."
      },
      "risk_note": "GDP反映宏观增长环境。",
      "interpretation": {
        "trend_up": "增长动能边际改善。",
        "trend_down": "增长动能边际走弱。",
        "flat": "增长动能变化不大。"
      }
    },
    {
      "id": "china_social_financing",
      "label": "中国社融",
      "candidate_functions": ["macro_china_shrzgm"],
      "date_columns": ["月份", "日期", "时间"],
      "value_columns": ["社会融资规模增量", "社融规模增量", "今值", "value"],
      "unit": "亿元",
      "cadence": "monthly",
      "max_age_days": 75,
      "release_calendar": {
        "source": "PBOC official release calendar",
        "source_tier": "official",
        "next_release_date": "",
        "note": "Fill in the next official release date in settings.local.json."
      },
      "risk_note": "社融反映信用扩张和实体融资环境。",
      "interpretation": {
        "trend_up": "信用扩张边际增强，观察实体融资和行业景气传导。",
        "trend_down": "信用扩张边际减弱，观察需求和风险偏好。",
        "flat": "社融变化不大，继续观察结构。"
      }
    },
    {
      "id": "us_treasury_10y",
      "label": "美国10Y国债收益率",
      "candidate_functions": ["bond_zh_us_rate"],
      "date_columns": ["日期", "时间"],
      "value_columns": ["美国:国债收益率:10年", "10年", "美国10年期国债收益率", "value"],
      "unit": "%",
      "cadence": "daily",
      "max_age_days": 10,
      "release_calendar": {
        "source": "US Treasury daily market data",
        "source_tier": "official",
        "next_release_date": "",
        "note": "Daily market data has no monthly release calendar; fill only if a local calendar is needed."
      },
      "risk_note": "美债收益率影响全球成长股估值和美元资产折现率。",
      "interpretation": {
        "trend_up": "美债收益率上行，成长股估值折现压力上升。",
        "trend_down": "美债收益率下行，成长股估值压力边际缓和。",
        "flat": "美债收益率变化不大。"
      }
    }
  ],
  "enable_news": false,
  "tavily_api_key_env": "TAVILY_API_KEY",
  "timezone": "Asia/Shanghai"
}
