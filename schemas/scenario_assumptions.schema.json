{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finance Agent Scenario Assumptions",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "shocks"],
    "properties": {
      "name": {"type": "string", "minLength": 1},
      "description": {"type": "string"},
      "shocks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["match", "shock_pct"],
          "properties": {
            "match": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "market": {"type": "string"},
                "factor_type": {"type": "string"},
                "benchmark": {"type": "string"},
                "strategy_type": {"type": "string"}
              },
              "additionalProperties": false
            },
            "shock_pct": {"type": ["number", "integer"], "minimum": -100, "maximum": 100}
          }
        }
      }
    }
  }
}
