{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finance Agent Portfolio",
  "type": "object",
  "required": ["user_profile", "risk_rules", "holdings", "watchlist"],
  "properties": {
    "updated": {"type": "string"},
    "user_profile": {"type": "object"},
    "cash": {"type": "object"},
    "risk_rules": {
      "type": "object",
      "required": ["single_loss_pct", "daily_loss_pct", "max_single_position_pct"],
      "properties": {
        "single_loss_pct": {"type": ["number", "integer"], "exclusiveMinimum": 0},
        "daily_loss_pct": {"type": ["number", "integer"], "exclusiveMinimum": 0},
        "max_single_position_pct": {"type": ["number", "integer"], "exclusiveMinimum": 0, "maximum": 100}
      }
    },
    "holdings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "strategy_type", "cost_basis", "shares", "buy_records"],
        "properties": {
          "code": {"type": "string"},
          "name": {"type": "string"},
          "strategy_type": {"type": "string"},
          "factor_profile": {
            "type": "object",
            "properties": {
              "type": {"type": "string"},
              "benchmark": {"type": "string"}
            }
          },
          "cost_basis": {"type": ["number", "integer"], "exclusiveMinimum": 0},
          "shares": {"type": ["number", "integer"], "exclusiveMinimum": 0},
          "expense_ratio": {"type": ["number", "integer"], "minimum": 0, "maximum": 100},
          "buy_records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "amount"],
              "properties": {
                "date": {"type": "string"},
                "confirm_date": {"type": "string"},
                "status": {"type": "string"},
                "amount": {"type": ["number", "integer"], "exclusiveMinimum": 0},
                "nav": {"type": ["number", "integer"], "exclusiveMinimum": 0},
                "shares": {"type": ["number", "integer"], "exclusiveMinimum": 0}
              }
            }
          }
        }
      }
    },
    "watchlist": {"type": "array"}
  }
}
